# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Byte-compiled / optimized / DLL files
*.pyo
*.pyd
*.so
*.dll

# Virtual envs
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Editors / IDE
.idea/
.vscode/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.env
*.secrets
secrets.*
.secret
*.key
*.pem

# Logs
logs/
*.log
*.log.*

# Local data/runtime artifacts
data/*
!data/.gitkeep
# если будут локальные загрузки
uploads/
media/
tmp/
tmp_*/

# SQLite / local DBs
*.db
*.sqlite
*.sqlite3

